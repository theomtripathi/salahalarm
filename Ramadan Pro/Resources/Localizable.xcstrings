{
  "sourceLanguage" : "en",
  "strings" : {
    "five times a day" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "خمس مرات في اليوم" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "lima kali sehari" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "günde beş vakit" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "دن میں پانچ مرتبہ" } } } },
    "three to four times a day" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "من ثلاث إلى أربع مرات في اليوم" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "tiga hingga empat kali sehari" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "günde üç ila dört vakit" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "دن میں تین سے چار مرتبہ" } } } },
    "one to two times a day" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مرة أو مرتين في اليوم" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "satu hingga dua kali sehari" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "günde bir veya iki vakit" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "دن میں ایک یا دو مرتبہ" } } } },
    "i currently don't pray at all" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا أؤدي الصلاة حاليًا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "saat ini saya belum salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "şu anda hiç namaz kılmıyorum" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "میں فی الحال نماز نہیں پڑھتا/پڑھتی" } } } },
    "You pray often and want to close the gap to full consistency." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تؤدي الصلاة غالبًا وترغب في المواظبة على الصلوات كلها." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Anda sering salat dan ingin lebih konsisten." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sık sık namaz kılıyorsunuz ve düzeninizi güçlendirmek istiyorsunuz." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ اکثر نماز پڑھتے ہیں اور باقاعدگی کو بہتر بنانا چاہتے ہیں۔" } } } },
    "You are rebuilding the habit and need more structure around prayer." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أنت تعيد بناء عادة الصلاة وتحتاج إلى روتين أكثر تنظيمًا." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Anda sedang membangun kembali kebiasaan salat dan membutuhkan rutinitas yang teratur." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namaz alışkanlığınızı yeniden kuruyor ve daha düzenli bir rutine ihtiyaç duyuyorsunuz." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ نماز کی عادت دوبارہ بنا رہے ہیں اور زیادہ منظم معمول چاہتے ہیں۔" } } } },
    "You are at the beginning of your prayer journey and need a simple first step." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أنت في بداية رحلتك مع الصلاة وتحتاج إلى خطوة أولى بسيطة." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Anda baru memulai perjalanan salat dan membutuhkan langkah awal sederhana." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namaz yolculuğunuzun başındasınız; basit bir ilk adıma ihtiyacınız var." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ نماز کے سفر کے آغاز میں ہیں اور ایک آسان پہلے قدم کی ضرورت ہے۔" } } } },
    "put Allah first, before my phone" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أقدّم رضا الله على هاتفي" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "mendahulukan Allah daripada ponsel saya" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Telefonumdan önce Allah'a öncelik vermek" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنے فون سے پہلے اللہ کو ترجیح دینا" } } } },
    "build a consistent prayer habit" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أبني عادة ثابتة للصلاة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "membangun kebiasaan salat yang konsisten" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Düzenli namaz alışkanlığı edinmek" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نماز کی پابندی کا معمول بنانا" } } } },
    "deepen my relationship with Allah" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أعمّق صلتي بالله" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "mempererat hubungan saya dengan Allah" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Allah ile bağımı güçlendirmek" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اللہ سے تعلق مضبوط کرنا" } } } },
    "start my day with Fajr" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أبدأ يومي بصلاة الفجر" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "memulai hari dengan salat Subuh" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Güne sabah namazıyla başlamak" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "دن کا آغاز فجر سے کرنا" } } } },
    "find peace in a chaotic world" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أجد السكينة وسط عالم مضطرب" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "menemukan ketenangan di tengah dunia yang sibuk" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kaotik dünyada huzur bulmak" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "افراتفری میں سکون پانا" } } } },
    "strengthen my imaan" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أقوّي إيماني" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "menguatkan iman saya" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İmanımı güçlendirmek" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنے ایمان کو مضبوط کرنا" } } } },
    "phone & social media distraction" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التشتت بسبب الهاتف ووسائل التواصل" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "terdistraksi oleh ponsel dan media sosial" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Telefon ve sosyal medya dikkatimi dağıtıyor" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "فون اور سوشل میڈیا سے توجہ بٹنا" } } } },
    "low motivation or tiredness" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ضعف الحافز أو التعب" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "kurang motivasi atau kelelahan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Düşük motivasyon veya yorgunluk" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "حوصلے کی کمی یا تھکن" } } } },
    "busy schedule, no time" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جدول مزدحم وضيق الوقت" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "jadwal padat dan tidak ada waktu" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yoğun program ve zaman yetersizliği" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "مصروف معمول اور وقت کی کمی" } } } },
    "wandering thoughts during salah" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "شرود الذهن أثناء الصلاة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "pikiran melayang saat salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namaz sırasında aklımın dağılması" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نماز میں خیالات کا بھٹکنا" } } } },
    "lack of discipline" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ضعف الانضباط" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "kurang disiplin" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Disiplin eksikliği" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نظم و ضبط کی کمی" } } } },
    "forgetting prayer times" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "نسيان أوقات الصلاة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "lupa waktu salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namaz vakitlerini unutmak" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نماز کے اوقات بھولنا" } } } },
    "it has its ups and downs" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تمرّ بفترات صعود وهبوط" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "ada pasang surutnya" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "inişli çıkışlı" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اتار چڑھاؤ رہتے ہیں" } } } },
    "feeling a bit distant lately" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أشعر ببعض البعد مؤخرًا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "belakangan ini terasa agak jauh" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Son zamanlarda biraz uzak hissediyorum" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "حال ہی میں کچھ دوری محسوس ہو رہی ہے" } } } },
    "i'm trying to rebuild my connection" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أحاول إعادة بناء صلتي بالله" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "saya berusaha membangun kembali kedekatan saya" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bağımı yeniden kurmaya çalışıyorum" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "میں اپنا تعلق دوبارہ مضبوط کرنے کی کوشش کر رہا/رہی ہوں" } } } },
    "close and consistent, Alhamdulillah" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "قريب وثابت، الحمد لله" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "dekat dan konsisten, alhamdulillah" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yakın ve düzenli, elhamdülillah" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "قریب اور پابند، الحمدللہ" } } } },
    "struggling with temptations" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أجد صعوبة في مقاومة المغريات" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "berjuang menghadapi godaan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Nefsimle mücadele ediyorum" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "خواہشات سے جدوجہد" } } } },
    "constant worry or anxiety" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "القلق والتوتر المستمران" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "terus merasa khawatir atau cemas" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sürekli endişe veya kaygı" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "مسلسل فکر یا اضطراب" } } } },
    "feeling spiritually empty" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أشعر بفراغ روحي" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "merasa hampa secara spiritual" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Manevi boşluk hissetmek" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "روحانی طور پر خالی محسوس کرنا" } } } },
    "pride or relying only on myself" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الكِبر أو الاعتماد على نفسي وحدي" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "kesombongan atau hanya mengandalkan diri sendiri" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Gurur veya yalnızca kendime güvenmek" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "تکبر یا صرف خود پر بھروسا" } } } },
    "I don't feel like my prayers are accepted" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا أشعر بأن دعائي يُستجاب" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "saya merasa doa saya belum diterima" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dualarımın kabul edildiğini hissetmiyorum" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "مجھے نہیں لگتا کہ میری دعائیں قبول ہو رہی ہیں" } } } },
    "Sunni" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "سني" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Sunni" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sünni" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سنی" } } } },
