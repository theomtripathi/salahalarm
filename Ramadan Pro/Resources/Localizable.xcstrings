    "your subscription supports the app,\nfuture updates, and continued improvements" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اشتراكك يدعم التطبيق\nوالتحديثات القادمة والتحسين المستمر" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "langganan Anda mendukung aplikasi,\npembaruan mendatang, dan peningkatan berkelanjutan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "aboneliğin uygulamayı,\ngelecek güncellemeleri ve sürekli gelişimi destekler" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کی سبسکرپشن ایپ،\nآنے والی اپڈیٹس اور مسلسل بہتری میں مدد کرتی ہے" } } } },
