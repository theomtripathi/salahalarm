    "Your subscription helps us keep improving the app\nand building more Islamic features you love. 💚" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اشتراكك يساعدنا على تحسين التطبيق باستمرار\nوبناء مزيد من الميزات الإسلامية التي تحبها. 💚" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Langganan Anda membantu kami terus menyempurnakan aplikasi\ndan membangun lebih banyak fitur Islami yang Anda sukai. 💚" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Aboneliğin uygulamayı geliştirmemize\nve sevdiğin daha fazla İslami özellik eklememize yardımcı olur. 💚" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کی سبسکرپشن ایپ کو بہتر بنانے\nاور آپ کی پسند کے مزید اسلامی فیچرز بنانے میں مدد کرتی ہے۔ 💚" } } } },
    "Unlock All Premium Features" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "افتح جميع الميزات المميزة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Buka Semua Fitur Premium" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tüm Premium Özelliklerin Kilidini Aç" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "تمام پریمیم فیچرز اَن لاک کریں" } } } },
    "Get full access to everything in SalahAlarm" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "احصل على وصول كامل لكل ما في SalahAlarm" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Akses penuh ke semua fitur SalahAlarm" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "SalahAlarm'daki her şeye tam erişim" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "SalahAlarm کی ہر چیز تک مکمل رسائی حاصل کریں" } } } },
    "Stay focused on your salah" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حافظ على تركيزك في صلاتك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tetap fokus pada salat Anda" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namazına odaklan" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنی نماز پر توجہ رکھیں" } } } },
    "Accurate Times" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مواقيت دقيقة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Waktu Akurat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Doğru Vakitler" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "درست اوقات" } } } },
    "Always on time" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "في الوقت دائمًا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Selalu tepat waktu" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Her zaman vaktinde" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ہمیشہ وقت پر" } } } },
    "Quran & Duas" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "القرآن والأدعية" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Al-Qur'an & Doa" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kur'an ve Dualar" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "قرآن اور دعائیں" } } } },
    "Read, listen & reflect" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اقرأ واستمع وتدبّر" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Baca, dengar & renungkan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Oku, dinle ve tefekkür et" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "پڑھیں، سنیں اور غور کریں" } } } },
    "Prayer Streaks" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "سلاسل الصلاة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Rangkaian Salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namaz Serileri" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نماز اسٹریکس" } } } },
    "Build consistency" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ابنِ المواظبة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Bangun konsistensi" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İstikrar kazan" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "باقاعدگی پیدا کریں" } } } },
    "Premium Widgets" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أدوات مميزة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Widget Premium" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Premium Widget'lar" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "پریمیم ویجیٹس" } } } },
    "Beautiful at a glance" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جميلة بنظرة واحدة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Indah sekilas pandang" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bir bakışta şık" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ایک نظر میں خوبصورت" } } } },
    "Find the right direction" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اعرف الاتجاه الصحيح" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Temukan arah yang tepat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Doğru yönü bul" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "صحیح سمت معلوم کریں" } } } },
    "LIMITED TIME OFFER" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "عرض لفترة محدودة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "PENAWARAN TERBATAS" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "SINIRLI SÜRELİ TEKLİF" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "محدود مدت کی آفر" } } } },
    "Special Annual Offer" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "عرض سنوي خاص" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Penawaran Tahunan Spesial" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Özel Yıllık Teklif" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "خصوصی سالانہ آفر" } } } },
    "More value. Less cost. Strengthen your Deen daily." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "قيمة أكبر وتكلفة أقل. قوِّ دينك كل يوم." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Lebih bernilai, lebih hemat. Kuatkan agama Anda setiap hari." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Daha çok değer, daha az maliyet. Dinini her gün güçlendir." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "زیادہ فائدہ، کم قیمت۔ روزانہ اپنا دین مضبوط کریں۔" } } } },
    "%@/month" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "%@/شهريًا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "%@/bulan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@/ay" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "%@/ماہ" } } } },
    "processing..." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ المعالجة..." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "memproses..." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "işleniyor..." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "کارروائی جاری ہے..." } } } },
    "Get Premium Annual Access" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "احصل على الاشتراك السنوي المميز" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Dapatkan Akses Premium Tahunan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yıllık Premium Erişim Al" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "پریمیم سالانہ رسائی حاصل کریں" } } } },
    "Secure & private" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "آمن وخاص" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Aman & privat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Güvenli ve gizli" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "محفوظ اور نجی" } } } },
    "Cancel anytime" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يمكنك الإلغاء في أي وقت" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Batalkan kapan saja" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İstediğin zaman iptal et" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "کسی بھی وقت منسوخ کریں" } } } },
    "What stopped you?" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ما الذي منعك؟" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Apa yang menghentikan Anda?" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seni ne durdurdu?" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کو کس چیز نے روکا؟" } } } },
    "Optional—this helps us improve. You can skip." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختياري، يساعدنا على التحسين. يمكنك التخطي." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Opsional—ini membantu kami berbenah. Anda boleh melewatinya." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İsteğe bağlı; gelişmemize yardımcı olur. Atlayabilirsin." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اختیاری ہے، اس سے ہمیں بہتری میں مدد ملتی ہے۔ آپ اسے چھوڑ سکتے ہیں۔" } } } },
    "The price is too high" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "السعر مرتفع جدًا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Harganya terlalu mahal" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Fiyat çok yüksek" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "قیمت بہت زیادہ ہے" } } } },
    "I'm not ready to subscribe" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لست مستعدًا للاشتراك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Saya belum siap berlangganan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Abone olmaya hazır değilim" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "میں ابھی سبسکرائب کرنے کے لیے تیار نہیں" } } } },
    "I want to try the app first" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أريد تجربة التطبيق أولًا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Saya ingin mencoba aplikasinya dulu" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Önce uygulamayı denemek istiyorum" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "میں پہلے ایپ آزمانا چاہتا/چاہتی ہوں" } } } },
    "Checkout didn't work" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لم تنجح عملية الدفع" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pembayaran tidak berhasil" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ödeme çalışmadı" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ادائیگی نہیں ہو سکی" } } } },
    "Another reason" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "سبب آخر" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Alasan lain" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Başka bir neden" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "کوئی اور وجہ" } } } },
    "Skip" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تخطٍّ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Lewati" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Atla" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "چھوڑیں" } } } },
    "Processing…" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ المعالجة…" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Memproses…" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İşleniyor…" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "کارروائی جاری ہے…" } } } },
    "plans are unavailable" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الخطط غير متاحة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "paket tidak tersedia" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "planlar kullanılamıyor" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "پلانز دستیاب نہیں ہیں" } } } },
    "We couldn't load your App Store pricing. Please try again." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذّر تحميل أسعار App Store. يُرجى المحاولة مرة أخرى." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kami tidak dapat memuat harga App Store Anda. Silakan coba lagi." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "App Store fiyatların yüklenemedi. Lütfen tekrar dene." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "App Store کی قیمتیں لوڈ نہیں ہو سکیں۔ براہِ کرم دوبارہ کوشش کریں۔" } } } },
    "try again" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حاول مرة أخرى" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "coba lagi" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "tekrar dene" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "دوبارہ کوشش کریں" } } } },
    "before you go..." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "قبل أن تغادر..." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "sebelum Anda pergi..." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "gitmeden önce..." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "جانے سے پہلے..." } } } },
    "Spin the Wheel 🎡" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أدِر العجلة 🎡" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Putar Roda 🎡" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Çarkı Çevir 🎡" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "پہیہ گھمائیں 🎡" } } } },
    "we want you closer to your faith,\nnot further from it.\neveryone wins something today." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "نريدك أقرب إلى إيمانك،\nلا أبعد عنه.\nالجميع يربح شيئًا اليوم." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "kami ingin Anda makin dekat dengan iman,\nbukan menjauh darinya.\nhari ini semua orang dapat hadiah." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "seni inancından uzak değil,\nona daha yakın görmek istiyoruz.\nbugün herkes bir şey kazanıyor." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ہم چاہتے ہیں کہ آپ اپنے ایمان کے قریب ہوں،\nاس سے دور نہیں۔\nآج ہر کوئی کچھ نہ کچھ جیتتا ہے۔" } } } },
    "🎁 you unlocked your second-spin deal" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "🎁 فتحت عرض الدورة الثانية" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "🎁 Anda membuka penawaran putaran kedua" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "🎁 ikinci çevirme fırsatının kilidini açtın" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "🎁 آپ نے دوسرے اسپن کی ڈیل اَن لاک کر لی" } } } },
    "your second-spin reward:" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مكافأة دورتك الثانية:" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "hadiah putaran kedua Anda:" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "ikinci çevirme ödülün:" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کے دوسرے اسپن کا انعام:" } } } },
    "claim my second-spin deal 🎁" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "احصل على عرض الدورة الثانية 🎁" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "klaim penawaran putaran kedua 🎁" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "ikinci çevirme fırsatımı al 🎁" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "میری دوسرے اسپن کی ڈیل حاصل کریں 🎁" } } } },
    "Restore failed" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فشلت الاستعادة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pemulihan gagal" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Geri yükleme başarısız" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "بحالی ناکام رہی" } } } },
    "Link unavailable" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الرابط غير متاح" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tautan tidak tersedia" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bağlantı kullanılamıyor" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "لنک دستیاب نہیں" } } } },
    "The part normal alarms miss" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ما تغفل عنه المنبهات العادية" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hal yang dilewatkan alarm biasa" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Normal alarmların atladığı kısım" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "وہ چیز جو عام الارم نہیں کرتے" } } } },
    "The Problem Isn't Setting an Alarm. It's How Easy It Is to Dismiss." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "المشكلة ليست في ضبط المنبه، بل في سهولة إيقافه." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Masalahnya Bukan Memasang Alarm, tetapi Betapa Mudahnya Mematikannya." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sorun Alarm Kurmak Değil. Onu Kapatmanın Bu Kadar Kolay Olması." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "مسئلہ الارم لگانا نہیں، اسے بند کرنا آسان ہونا ہے۔" } } } },
    "One tap, one snooze, and the moment passes. SalahAlarm adds a real action between the reminder and turning it off." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لمسة واحدة، غفوة واحدة، وتفوت اللحظة. يضيف SalahAlarm خطوة حقيقية بين التذكير وإيقافه." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Sekali ketuk, sekali tunda, dan momennya berlalu. SalahAlarm menambahkan tindakan nyata antara pengingat dan mematikannya." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bir dokunuş, bir erteleme ve an geçip gider. SalahAlarm, hatırlatma ile kapatma arasına gerçek bir eylem ekler." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ایک ٹیپ، ایک اسنوز، اور لمحہ گزر جاتا ہے۔ SalahAlarm یاد دہانی اور اسے بند کرنے کے بیچ ایک حقیقی قدم شامل کرتا ہے۔" } } } },
    "see how it works" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "شاهد كيف يعمل" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "lihat cara kerjanya" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "nasıl çalıştığını gör" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "دیکھیں یہ کیسے کام کرتا ہے" } } } },
    "YOUR NEXT SALAH CAN BE DIFFERENT" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "صلاتك القادمة يمكن أن تكون مختلفة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "SALAT BERIKUTNYA BISA BERBEDA" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "SIRADAKİ NAMAZIN FARKLI OLABİLİR" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کی اگلی نماز مختلف ہو سکتی ہے" } } } },
    "Set an alarm you can't dismiss from bed." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اضبط منبهًا لا يمكنك إيقافه وأنت في السرير." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pasang alarm yang tak bisa dimatikan dari tempat tidur." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yataktan kapatamayacağın bir alarm kur." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ایسا الارم لگائیں جو بستر سے بند نہ ہو سکے۔" } } } },
    "SalahAlarm keeps the reminder active until you get up and scan your prayer mat." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يُبقي SalahAlarm التذكير نشطًا حتى تنهض وتمسح سجادة صلاتك." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "SalahAlarm membuat pengingat tetap aktif sampai Anda bangun dan memindai sajadah." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "SalahAlarm, kalkıp seccadeni taratana kadar hatırlatmayı açık tutar." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "SalahAlarm یاد دہانی کو تب تک چالو رکھتا ہے جب تک آپ اٹھ کر اپنی جائے نماز اسکین نہ کر لیں۔" } } } },
    "Your prayer alarm rings" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يرنّ منبه صلاتك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Alarm salat Anda berbunyi" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namaz alarmın çalar" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کا نماز کا الارم بجتا ہے" } } } },
    "A clear interruption at prayer time" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تنبيه واضح عند وقت الصلاة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Interupsi jelas saat waktu salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namaz vaktinde net bir uyarı" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نماز کے وقت واضح یاد دہانی" } } } },
    "You get up" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تنهض من مكانك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Anda bangun" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kalkarsın" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ اٹھتے ہیں" } } } },
    "No dismissing it half-asleep" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا إيقاف وأنت نصف نائم" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tidak bisa dimatikan sambil setengah tidur" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yarı uykuluyken kapatmak yok" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آدھی نیند میں بند کرنا ممکن نہیں" } } } },
    "Scan your prayer mat" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "امسح سجادة صلاتك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pindai sajadah Anda" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seccadeni tarat" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنی جائے نماز اسکین کریں" } } } },
    "The alarm stops and your salah is logged" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يتوقف المنبه وتُسجَّل صلاتك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Alarm berhenti dan salat Anda tercatat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Alarm durur ve namazın kaydedilir" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "الارم رک جاتا ہے اور آپ کی نماز درج ہو جاتی ہے" } } } },
    "set up my first alarm" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اضبط منبهي الأول" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "atur alarm pertama saya" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "ilk alarmımı kur" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "میرا پہلا الارم سیٹ کریں" } } } },
    "Pray First." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "صلِّ أولًا." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Salat Dulu." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Önce Namaz." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "پہلے نماز۔" } } } },
    "Then Unlock\nYour Apps." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ثم افتح\nتطبيقاتك." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Lalu Buka\nAplikasi Anda." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sonra Uygulamalarının\nKilidini Aç." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "پھر اپنی ایپس\nاَن لاک کریں۔" } } } },
    "Then unlock your apps." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ثم افتح تطبيقاتك." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Lalu buka aplikasi Anda." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sonra uygulamalarının kilidini aç." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "پھر اپنی ایپس اَن لاک کریں۔" } } } },
    "A simple loop that turns prayer time into action." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حلقة بسيطة تحوّل وقت الصلاة إلى فعل." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Siklus sederhana yang mengubah waktu salat menjadi tindakan." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namaz vaktini eyleme dönüştüren basit bir döngü." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ایک سادہ سلسلہ جو نماز کے وقت کو عمل میں بدل دیتا ہے۔" } } } },
    "Prayer time arrives" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحين وقت الصلاة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Waktu salat tiba" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namaz vakti gelir" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نماز کا وقت آتا ہے" } } } },
    "A persistent alarm interrupts the scroll." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "منبه مستمر يقطع التصفح." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Alarm yang terus berbunyi menghentikan scroll Anda." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Israrcı bir alarm kaydırmayı böler." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "مسلسل بجنے والا الارم اسکرولنگ روک دیتا ہے۔" } } } },
    "Distractions pause" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تتوقف المشتتات" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Gangguan berhenti" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dikkat dağıtıcılar durur" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "خلل ڈالنے والی چیزیں رک جاتی ہیں" } } } },
    "The apps you choose stay blocked." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تبقى التطبيقات التي تختارها محظورة." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Aplikasi pilihan Anda tetap diblokir." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seçtiğin uygulamalar engelli kalır." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کی منتخب کردہ ایپس بلاک رہتی ہیں۔" } } } },
    "The alarm ends, apps unlock, and salah is logged." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يتوقف المنبه، وتُفتح التطبيقات، وتُسجَّل الصلاة." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Alarm berhenti, aplikasi terbuka, dan salat tercatat." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Alarm biter, uygulamaların kilidi açılır ve namaz kaydedilir." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "الارم بند ہوتا ہے، ایپس کھل جاتی ہیں اور نماز درج ہو جاتی ہے۔" } } } },
    "No complicated setup. Just one clear next step." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا إعداد معقد. خطوة تالية واضحة فقط." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tanpa pengaturan rumit. Hanya satu langkah jelas berikutnya." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Karmaşık kurulum yok. Sadece net bir sonraki adım." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "کوئی پیچیدہ سیٹ اپ نہیں۔ بس ایک واضح اگلا قدم۔" } } } },
    "personalize my plan" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "خصّص خطتي" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "sesuaikan rencana saya" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "planımı kişiselleştir" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "میرا پلان ذاتی بنائیں" } } } },
    "Which Prayers Do You Want Alarms For?" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لأي صلوات تريد منبهات؟" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Salat Mana Saja yang Ingin Diberi Alarm?" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hangi Namazlar İçin Alarm İstiyorsun?" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کن نمازوں کے لیے الارم چاہتے ہیں؟" } } } },
    "choose the ones you miss most.\nwe'll only ring when you actually need it." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختر الصلوات التي تفوتك أكثر.\nلن نرنّ إلا عندما تحتاج فعلًا." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "pilih yang paling sering terlewat.\nkami hanya berbunyi saat Anda benar-benar membutuhkannya." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "en çok kaçırdıklarını seç.\nsadece gerçekten ihtiyacın olduğunda çalarız." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "وہ نمازیں چنیں جو سب سے زیادہ چھوٹتی ہیں۔\nہم صرف تب بجیں گے جب واقعی ضرورت ہو۔" } } } },
    "all five" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الخمس كلها" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "kelima waktu" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "beşi de" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "پانچوں" } } } },
    "just fajr" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الفجر فقط" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "subuh saja" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "sadece sabah" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "صرف فجر" } } } },
    "custom" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مخصص" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "kustom" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "özel" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنی مرضی" } } } },
    "continue" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "متابعة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "lanjut" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "devam et" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "جاری رکھیں" } } } },
    "Picture 30 Days of Showing Up." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تخيّل 30 يومًا من المواظبة." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Bayangkan 30 Hari Selalu Hadir." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "30 Gün Boyunca Namazına Durduğunu Hayal Et." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "30 دن کی پابندی کا تصور کریں۔" } } } },
    "Choose a pace that feels sustainable. It can be changed anytime." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختر وتيرة يمكنك الاستمرار عليها. يمكن تغييرها في أي وقت." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pilih ritme yang bisa Anda jalani. Bisa diubah kapan saja." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sürdürebileceğin bir tempo seç. İstediğin zaman değiştirebilirsin." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ایسی رفتار چنیں جو آپ برقرار رکھ سکیں۔ اسے کبھی بھی بدلا جا سکتا ہے۔" } } } },
    "Strong structure" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "انضباط قوي" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Struktur kuat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Güçlü düzen" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "مضبوط نظم" } } } },
    "Persistent alarms and strict app blocking" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "منبهات مستمرة وحظر صارم للتطبيقات" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Alarm terus-menerus dan blokir aplikasi ketat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Israrcı alarmlar ve sıkı uygulama engelleme" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "مسلسل الارم اور ایپس کی سخت بندش" } } } },
    "Balanced support" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "دعم متوازن" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Dukungan seimbang" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dengeli destek" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "متوازن مدد" } } } },
    "Consistent reminders with a practical routine" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تذكيرات منتظمة مع روتين عملي" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pengingat rutin dengan kebiasaan yang praktis" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Pratik bir rutinle düzenli hatırlatmalar" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "عملی معمول کے ساتھ باقاعدہ یاد دہانیاں" } } } },
    "Gentle beginning" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "بداية لطيفة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Awal yang ringan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Nazik bir başlangıç" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نرم آغاز" } } } },
    "Start small and strengthen the habit over time" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ابدأ بخطوات صغيرة وقوِّ العادة مع الوقت" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mulai dari kecil dan kuatkan kebiasaan seiring waktu" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Küçük başla, alışkanlığı zamanla güçlendir" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "چھوٹے قدم سے شروع کریں اور وقت کے ساتھ عادت پختہ کریں" } } } },
    "create my plan" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أنشئ خطتي" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "buat rencana saya" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "planımı oluştur" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "میرا پلان بنائیں" } } } },
    "We're Building\nYour Prayer Plan..." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "نُعدّ\nخطة صلاتك..." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kami Menyusun\nRencana Salat Anda..." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namaz Planını\nHazırlıyoruz..." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ہم آپ کا\nنماز پلان بنا رہے ہیں..." } } } },
    "✅  setting up alarms for your city" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "✅  ضبط المنبهات لمدينتك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "✅  menyiapkan alarm untuk kota Anda" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "✅  şehrin için alarmlar kuruluyor" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "✅  آپ کے شہر کے لیے الارم سیٹ ہو رہے ہیں" } } } },
    "✅  calibrating your alarm intensity" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "✅  ضبط شدة المنبه" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "✅  menyesuaikan intensitas alarm" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "✅  alarm şiddetin ayarlanıyor" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "✅  الارم کی شدت ترتیب دی جا رہی ہے" } } } },
    "✅  preparing your first-week target" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "✅  تجهيز هدف أسبوعك الأول" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "✅  menyiapkan target minggu pertama" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "✅  ilk hafta hedefin hazırlanıyor" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "✅  پہلے ہفتے کا ہدف تیار ہو رہا ہے" } } } },
    "PERSONALIZED PLAN READY" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "خطتك المخصصة جاهزة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "RENCANA PERSONAL SIAP" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "KİŞİSEL PLANIN HAZIR" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کا ذاتی پلان تیار ہے" } } } },
    "Your first alarm" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "منبهك الأول" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Alarm pertama Anda" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İlk alarmın" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کا پہلا الارم" } } } },
    "%@ at %@" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "%@ الساعة %@" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "%@ pukul %@" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ saat %@" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "%@ بوقت %@" } } } },
    "Calculated for your location. It keeps ringing until you reach your mat." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "محسوب حسب موقعك. يستمر في الرنين حتى تصل إلى سجادتك." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Dihitung sesuai lokasi Anda. Terus berbunyi sampai Anda mencapai sajadah." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Konumuna göre hesaplandı. Seccadene ulaşana kadar çalmaya devam eder." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کے مقام کے مطابق حساب کیا گیا۔ یہ تب تک بجتا رہے گا جب تک آپ جائے نماز تک نہ پہنچیں۔" } } } },
    "Prayer coverage" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الصلوات المشمولة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Cakupan salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kapsanan namazlar" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "شامل نمازیں" } } } },
    "%d prayers" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "%d صلوات" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "%d salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%d namaz" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "%d نمازیں" } } } },
    "Support level" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مستوى الدعم" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tingkat dukungan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Destek seviyesi" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "مدد کی سطح" } } } },
    "Primary goal" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الهدف الأساسي" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tujuan utama" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ana hedef" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "بنیادی مقصد" } } } },
    "build prayer consistency" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "المواظبة على الصلاة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "membangun konsistensi salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "namazda istikrar kazanmak" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نماز میں باقاعدگی پیدا کرنا" } } } },
    "Your reminders and progress will reinforce this goal." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ستعزز تذكيراتك وتقدّمك هذا الهدف." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pengingat dan kemajuan Anda akan memperkuat tujuan ini." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hatırlatmaların ve ilerlemen bu hedefi güçlendirecek." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کی یاد دہانیاں اور پیش رفت اس مقصد کو مضبوط کریں گی۔" } } } },
    "Pause distractions" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أوقف المشتتات" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hentikan gangguan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dikkat dağıtıcıları durdur" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "خلل روکیں" } } } },
    "Reach your mat" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اصل إلى سجادتك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Raih sajadah Anda" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seccadene ulaş" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "جائے نماز تک پہنچیں" } } } },
    "Build the streak" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ابنِ سلسلتك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Bangun rangkaian" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Serini oluştur" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اسٹریک بنائیں" } } } },
    "continue with my plan" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تابع بخطتي" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "lanjut dengan rencana saya" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "planımla devam et" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنے پلان کے ساتھ آگے بڑھیں" } } } },
    "Allow SalahAlarm to Reach You" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اسمح لـ SalahAlarm بالوصول إليك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Izinkan SalahAlarm Menghubungi Anda" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "SalahAlarm'ın Sana Ulaşmasına İzin Ver" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "SalahAlarm کو آپ تک پہنچنے دیں" } } } },
    "without notifications, your alarms can't ring.\n\nwe'll send two notifications per prayer:\na heads-up reminder, then the alarm itself." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "بدون الإشعارات لن ترنّ منبهاتك.\n\nسنرسل إشعارين لكل صلاة:\nتذكيرًا مسبقًا، ثم المنبه نفسه." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "tanpa notifikasi, alarm Anda tidak bisa berbunyi.\n\nkami mengirim dua notifikasi per salat:\npengingat awal, lalu alarmnya." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "bildirimler olmadan alarmların çalamaz.\n\nher namaz için iki bildirim göndeririz:\nönce bir hatırlatma, sonra alarmın kendisi." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نوٹیفکیشنز کے بغیر آپ کے الارم نہیں بج سکتے۔\n\nہم ہر نماز کے لیے دو نوٹیفکیشن بھیجیں گے:\nپہلے یاد دہانی، پھر خود الارم۔" } } } },
    "Fajr is in 10 minutes. get ready." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الفجر بعد 10 دقائق. استعد." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Subuh 10 menit lagi. bersiaplah." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sabah namazına 10 dakika var. hazırlan." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "فجر میں 10 منٹ باقی ہیں۔ تیار ہو جائیں۔" } } } },
    "it's time for Fajr. scan your mat to confirm." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حان وقت الفجر. امسح سجادتك للتأكيد." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "sudah waktunya Subuh. pindai sajadah untuk konfirmasi." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "sabah namazı vakti. onaylamak için seccadeni tarat." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "فجر کا وقت ہو گیا۔ تصدیق کے لیے جائے نماز اسکین کریں۔" } } } },
    "allow" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "سماح" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "izinkan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "izin ver" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اجازت دیں" } } } },
    "skip for now" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تخطَّ الآن" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "lewati dulu" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "şimdilik atla" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ابھی چھوڑ دیں" } } } },
    "Choose your alarm sound" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختر صوت المنبه" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pilih suara alarm" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Alarm sesini seç" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنی الارم کی آواز چنیں" } } } },
    "pick something you won't sleep through.\nthis matters most for Fajr.\nyou can change it later in settings." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختر صوتًا لن تنام خلاله.\nهذا أهم ما يكون في الفجر.\nيمكنك تغييره لاحقًا من الإعدادات." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "pilih suara yang tak bisa Anda abaikan saat tidur.\nini paling penting untuk Subuh.\nAnda bisa mengubahnya nanti di pengaturan." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "uyurken duymazdan gelemeyeceğin bir ses seç.\nbu en çok sabah namazı için önemli.\ndaha sonra ayarlardan değiştirebilirsin." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ایسی آواز چنیں جس میں آپ سوتے نہ رہ جائیں۔\nیہ فجر کے لیے سب سے اہم ہے۔\nآپ اسے بعد میں سیٹنگز میں بدل سکتے ہیں۔" } } } },
    "precise direction to Makkah using your device sensors" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اتجاه دقيق نحو مكة باستخدام مستشعرات جهازك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "arah tepat ke Makkah menggunakan sensor perangkat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "cihaz sensörlerinle Mekke'ye kesin yön" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنے فون کے سینسرز سے مکہ کی درست سمت" } } } },
    "keep distracting apps locked until you've prayed" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أبقِ التطبيقات المشتتة مقفلة حتى تصلي" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "kunci aplikasi pengganggu sampai Anda selesai salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "namazını kılana kadar dikkat dağıtan uygulamaları kilitli tut" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نماز پڑھنے تک خلل ڈالنے والی ایپس لاک رکھیں" } } } },
    "Daily Duas" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أدعية يومية" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Doa Harian" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Günlük Dualar" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "روزانہ دعائیں" } } } },
    "99+ rotating duas from Quran and Hadith" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أكثر من 99 دعاءً متجددًا من القرآن والحديث" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "99+ doa bergantian dari Al-Qur'an dan Hadis" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kur'an ve hadisten 99+ değişen dua" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "قرآن و حدیث سے 99+ بدلتی دعائیں" } } } },
    "Building and maintaining this app takes real resources." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "بناء هذا التطبيق وصيانته يتطلبان موارد حقيقية." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Membangun dan merawat aplikasi ini butuh sumber daya nyata." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu uygulamayı geliştirmek ve sürdürmek gerçek kaynak gerektirir." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اس ایپ کو بنانے اور چلانے کے لیے حقیقی وسائل درکار ہیں۔" } } } },
    "Your subscription supports our small team, keeps servers running, and funds new features to help you stay accountable to your salah." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اشتراكك يدعم فريقنا الصغير، ويُبقي الخوادم تعمل، ويموّل ميزات جديدة تساعدك على المحافظة على صلاتك." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Langganan Anda mendukung tim kecil kami, menjaga server tetap berjalan, dan mendanai fitur baru agar Anda tetap menjaga salat." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Aboneliğin küçük ekibimizi destekler, sunucuları çalışır tutar ve namazına bağlı kalmana yardım edecek yeni özellikleri finanse eder." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کی سبسکرپشن ہماری چھوٹی ٹیم کی مدد کرتی ہے، سرورز چلاتی ہے اور نئے فیچرز کے لیے فنڈ دیتی ہے تاکہ آپ نماز کے پابند رہیں۔" } } } },
    "see our plans" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اطّلع على خططنا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "lihat paket kami" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "planlarımızı gör" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ہمارے پلانز دیکھیں" } } } },
    "Turn Off Silent Mode" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أوقف الوضع الصامت" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Matikan Mode Senyap" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sessiz Modu Kapat" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سائلنٹ موڈ بند کریں" } } } },
    "silent phones bury alarms — especially at Fajr" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الهاتف الصامت يُخفي المنبهات، خاصة عند الفجر" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "ponsel senyap meredam alarm, terutama saat Subuh" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "sessiz telefon alarmları bastırır, özellikle sabah namazında" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سائلنٹ فون الارم دبا دیتا ہے، خاص طور پر فجر میں" } } } },
    "Allow Notifications Through Focus" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اسمح بالإشعارات أثناء التركيز" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Izinkan Notifikasi Saat Mode Fokus" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Odak Modunda Bildirimlere İzin Ver" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "فوکس موڈ میں نوٹیفکیشنز کی اجازت دیں" } } } },
    "do not disturb should never suppress prayer alarms" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يجب ألا يحجب وضع عدم الإزعاج منبهات الصلاة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "mode jangan ganggu tidak boleh membungkam alarm salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "rahatsız etme modu namaz alarmlarını asla susturmamalı" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ڈو ناٹ ڈسٹرب کو نماز کے الارم کبھی نہیں روکنے چاہئیں" } } } },
    "Raise Your Ringer Volume" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ارفع مستوى صوت الرنين" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Naikkan Volume Dering" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Zil Sesini Yükselt" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "رنگر کی آواز بڑھائیں" } } } },
    "especially the night before, when Fajr is coming" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "خاصة في الليلة السابقة لصلاة الفجر" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "terutama malam sebelum Subuh" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "özellikle sabah namazından önceki gece" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "خاص طور پر فجر سے پہلے کی رات" } } } },
    "Prayer time" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "وقت الصلاة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Waktu salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namaz vakti" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نماز کا وقت" } } } },
    "Apps paused" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التطبيقات متوقفة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Aplikasi dijeda" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Uygulamalar durduruldu" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ایپس رکی ہوئی ہیں" } } } },
    "week 1" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الأسبوع 1" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "minggu 1" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "1. hafta" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ہفتہ 1" } } } },
    "week 2" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الأسبوع 2" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "minggu 2" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "2. hafta" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ہفتہ 2" } } } },
    "week 3" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الأسبوع 3" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "minggu 3" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "3. hafta" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ہفتہ 3" } } } },
    "relationship with salah" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "العلاقة مع الصلاة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "hubungan dengan salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "namazla ilişki" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نماز سے تعلق" } } } },
    "✕ skipped prayers" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "✕ صلوات فائتة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "✕ salat terlewat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "✕ kaçırılan namazlar" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "✕ چھوٹی ہوئی نمازیں" } } } },
    "prayer\njourney" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "رحلة\nالصلاة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "perjalanan\nsalat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "namaz\nyolculuğu" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نماز کا\nسفر" } } } },
    "locked\nphone" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "هاتف\nمقفل" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "ponsel\nterkunci" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "kilitli\ntelefon" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "لاک\nفون" } } } },
    "prayed\non time" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "صلّى\nفي وقتها" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "salat\ntepat waktu" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "vaktinde\nkılındı" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "وقت پر\nنماز" } } } },
    "discipline\nbuilt" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "انضباط\nمكتسب" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "disiplin\nterbentuk" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "disiplin\nkazanıldı" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نظم و ضبط\nپیدا ہوا" } } } },
    "missed fajr" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فاتني الفجر" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "subuh terlewat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "sabahı kaçırdım" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "فجر چھوٹ گئی" } } } },
    "i'll pray later" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "سأصلي لاحقًا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "nanti saja salatnya" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "sonra kılarım" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "بعد میں پڑھ لوں گا/گی" } } } },
    "just one\nmore scroll" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تمريرة\nأخيرة فقط" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "satu scroll\nlagi saja" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "sadece bir\nkaydırma daha" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "بس ایک\nاور اسکرول" } } } },
    "shaytan\nwon again" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "انتصر الشيطان\nمرة أخرى" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "setan\nmenang lagi" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "şeytan\nyine kazandı" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "شیطان\nپھر جیت گیا" } } } },
    "your phone can either pull you away...\nor help you stay consistent." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "هاتفك إما أن يُبعدك...\nأو يساعدك على المواظبة." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "ponsel Anda bisa menjauhkan Anda...\natau membantu Anda tetap konsisten." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "telefonun ya seni uzaklaştırır...\nya da istikrarlı kalmana yardım eder." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کا فون یا تو آپ کو دور لے جاتا ہے...\nیا باقاعدہ رہنے میں مدد کرتا ہے۔" } } } },
    "start your streak" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ابدأ سلسلتك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "mulai rangkaian Anda" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "serini başlat" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنی اسٹریک شروع کریں" } } } },
    "Establish prayer and give zakah, and bow with those who bow." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ وَارْكَعُوا مَعَ الرَّاكِعِينَ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Dirikanlah salat, tunaikanlah zakat, dan rukuklah bersama orang-orang yang rukuk." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namazı kılın, zekâtı verin ve rükû edenlerle birlikte rükû edin." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اور نماز قائم کرو اور زکوٰۃ دو اور رکوع کرنے والوں کے ساتھ رکوع کرو۔" } } } },
    "Quran 2:43" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "البقرة: 43" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "QS. Al-Baqarah 2:43" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bakara 2:43" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سورۃ البقرہ 2:43" } } } },
    "Indeed, prayer prohibits immorality and wrongdoing." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إِنَّ الصَّلَاةَ تَنْهَىٰ عَنِ الْفَحْشَاءِ وَالْمُنكَرِ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Sesungguhnya salat itu mencegah dari perbuatan keji dan mungkar." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Şüphesiz namaz, hayasızlıktan ve kötülükten alıkoyar." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "بے شک نماز بے حیائی اور برائی سے روکتی ہے۔" } } } },
    "Quran 29:45" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "العنكبوت: 45" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "QS. Al-'Ankabut 29:45" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ankebût 29:45" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سورۃ العنکبوت 29:45" } } } },
    "Seek help through patience and prayer." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "وَاسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mohonlah pertolongan dengan sabar dan salat." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sabır ve namazla yardım dileyin." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "صبر اور نماز سے مدد لو۔" } } } },
    "Quran 2:45" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "البقرة: 45" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "QS. Al-Baqarah 2:45" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bakara 2:45" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سورۃ البقرہ 2:45" } } } },
    "And establish prayer for My remembrance." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "وَأَقِمِ الصَّلَاةَ لِذِكْرِي" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Dan dirikanlah salat untuk mengingat-Ku." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Beni anmak için namaz kıl." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اور میری یاد کے لیے نماز قائم کرو۔" } } } },
    "Quran 20:14" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "طه: 14" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "QS. Taha 20:14" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tâhâ 20:14" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سورۃ طٰہٰ 20:14" } } } },
    "Successful indeed are the believers, those who are humble in their prayer." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "قَدْ أَفْلَحَ الْمُؤْمِنُونَ ۝ الَّذِينَ هُمْ فِي صَلَاتِهِمْ خَاشِعُونَ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Sungguh beruntung orang-orang yang beriman, yaitu orang yang khusyuk dalam salatnya." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Müminler gerçekten kurtuluşa ermiştir; onlar ki namazlarında huşû içindedirler." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "یقیناً ایمان والے کامیاب ہو گئے، جو اپنی نماز میں عاجزی کرتے ہیں۔" } } } },
    "Quran 23:1-2" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "المؤمنون: 1-2" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "QS. Al-Mu'minun 23:1-2" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Mü'minûn 23:1-2" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سورۃ المؤمنون 23:1-2" } } } },
    "Did you pray %@?" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "هل صليت %@؟" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Sudahkah Anda salat %@?" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ namazını kıldın mı?" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "کیا آپ نے %@ پڑھ لی؟" } } } },
    "i prayed 🤲" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "صلّيت 🤲" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "saya sudah salat 🤲" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "kıldım 🤲" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "میں نے نماز پڑھ لی 🤲" } } } },
    "not yet" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ليس بعد" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "belum" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "henüz değil" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ابھی نہیں" } } } },
    "you won! 🎉" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لقد ربحت! 🎉" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Anda menang! 🎉" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "kazandın! 🎉" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ جیت گئے! 🎉" } } } },
    "spinning..." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ التدوير..." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "memutar..." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "dönüyor..." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "گھوم رہا ہے..." } } } },
    "spin the wheel" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أدِر العجلة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "putar roda" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "çarkı çevir" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "پہیہ گھمائیں" } } } },
    "Support Our Cause" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ادعم رسالتنا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Dukung Misi Kami" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Davamıza Destek Ol" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ہمارے مقصد کی مدد کریں" } } } },
    "Select an amount to donate" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختر مبلغًا للتبرع" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pilih jumlah donasi" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bağış miktarı seç" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "عطیہ کی رقم منتخب کریں" } } } },
    "Donation Amount" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مبلغ التبرع" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Jumlah Donasi" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bağış Miktarı" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "عطیہ کی رقم" } } } },
    "Loading options…" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ تحميل الخيارات…" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Memuat pilihan…" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seçenekler yükleniyor…" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپشنز لوڈ ہو رہے ہیں…" } } } },
    "No donation options" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا توجد خيارات تبرع" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tidak ada pilihan donasi" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bağış seçeneği yok" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "عطیہ کے آپشنز دستیاب نہیں" } } } },
    "Select amount" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختر المبلغ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pilih jumlah" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Miktar seç" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "رقم منتخب کریں" } } } },
    "Please select a donation amount" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يُرجى اختيار مبلغ التبرع" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Silakan pilih jumlah donasi" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Lütfen bir bağış miktarı seç" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "براہِ کرم عطیہ کی رقم منتخب کریں" } } } },
    "Donate" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تبرّع" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Donasi" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bağış yap" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "عطیہ دیں" } } } },
    "Donate Later" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تبرّع لاحقًا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Donasi nanti" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Daha sonra bağış yap" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "بعد میں عطیہ دیں" } } } },
    "alarm sound requires action" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "صوت المنبه يحتاج إلى إجراء" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "suara alarm perlu tindakan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "alarm sesi için işlem gerekiyor" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "الارم کی آواز کے لیے کارروائی درکار ہے" } } } },
    "turn off Silent Mode and Do Not Disturb so your alarms ring." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أوقف الوضع الصامت وعدم الإزعاج حتى ترنّ منبهاتك." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "matikan Mode Senyap dan Jangan Ganggu agar alarm berbunyi." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "alarmlarının çalması için Sessiz Mod'u ve Rahatsız Etme'yi kapat." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سائلنٹ موڈ اور ڈو ناٹ ڈسٹرب بند کریں تاکہ آپ کے الارم بجیں۔" } } } },
    "fix ->" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إصلاح ←" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "perbaiki ->" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "düzelt ->" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ٹھیک کریں ←" } } } },
    "Before alarms can work reliably, double-check these settings." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "قبل أن تعمل المنبهات بشكل موثوق، تحقق من هذه الإعدادات." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Agar alarm bekerja dengan andal, periksa kembali pengaturan ini." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Alarmların güvenilir çalışması için bu ayarları kontrol et." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "الارم کے صحیح کام کرنے سے پہلے یہ سیٹنگز دوبارہ چیک کریں۔" } } } },
    "Silent mode" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الوضع الصامت" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mode senyap" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sessiz mod" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سائلنٹ موڈ" } } } },
    "Keep the phone out of silent mode during prayer windows." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أبقِ الهاتف خارج الوضع الصامت في أوقات الصلاة." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Jangan aktifkan mode senyap selama waktu salat." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namaz vakitlerinde telefonu sessiz modda tutma." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نماز کے اوقات میں فون کو سائلنٹ موڈ پر نہ رکھیں۔" } } } },
    "Do Not Disturb" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "عدم الإزعاج" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Jangan Ganggu" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Rahatsız Etme" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ڈو ناٹ ڈسٹرب" } } } },
    "Allow SalahAlarm notifications to break through Focus modes." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اسمح لإشعارات SalahAlarm بتجاوز أوضاع التركيز." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Izinkan notifikasi SalahAlarm menembus mode Fokus." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "SalahAlarm bildirimlerinin Odak modlarını aşmasına izin ver." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "SalahAlarm کی نوٹیفکیشنز کو فوکس موڈز میں بھی آنے دیں۔" } } } },
    "Volume" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مستوى الصوت" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Volume" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ses düzeyi" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آواز" } } } },
    "Set your ringer and media volume high enough for Fajr." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اجعل صوت الرنين والوسائط مرتفعًا بما يكفي للفجر." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Atur volume dering dan media cukup keras untuk Subuh." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Zil ve medya sesini sabah namazı için yeterince yüksek ayarla." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "رنگر اور میڈیا کی آواز فجر کے لیے کافی اونچی رکھیں۔" } } } },
    "done" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "selesai" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "tamam" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ہو گیا" } } } },
    "Alarm Setup" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إعداد المنبه" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pengaturan Alarm" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Alarm Kurulumu" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "الارم سیٹ اپ" } } } },
    "Prayer alarms" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "منبهات الصلاة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Alarm salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namaz alarmları" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نماز کے الارم" } } } },
    "Enable all alarms" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تفعيل جميع المنبهات" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Aktifkan semua alarm" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tüm alarmları aç" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "تمام الارم چالو کریں" } } } },
    "Strictness" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الصرامة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tingkat ketegasan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Katılık" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سختی" } } } },
    "Mode" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الوضع" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mode" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Mod" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "موڈ" } } } },
    "Sound" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الصوت" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Suara" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ses" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آواز" } } } },
    "Alarm sound" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "صوت المنبه" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Suara alarm" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Alarm sesi" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "الارم کی آواز" } } } },
    "Test alarm overlay" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختبار شاشة المنبه" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Uji tampilan alarm" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Alarm ekranını test et" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "الارم اسکرین آزمائیں" } } } },
    "Recent alarm activity" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "نشاط المنبه الأخير" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Aktivitas alarm terbaru" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Son alarm etkinliği" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "حالیہ الارم سرگرمی" } } } },
    "Alarm Settings" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إعدادات المنبه" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pengaturan Alarm" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Alarm Ayarları" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "الارم سیٹنگز" } } } },
    "Point your camera at your prayer mat." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "وجّه الكاميرا نحو سجادة صلاتك." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Arahkan kamera ke sajadah Anda." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kameranı seccadene doğrult." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "کیمرہ اپنی جائے نماز کی طرف کریں۔" } } } },
    "Capture a photo of your janamaz to dismiss this alarm." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التقط صورة لسجادة صلاتك لإيقاف هذا المنبه." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Ambil foto sajadah Anda untuk mematikan alarm ini." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu alarmı kapatmak için seccadenin fotoğrafını çek." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "یہ الارم بند کرنے کے لیے اپنی جائے نماز کی تصویر لیں۔" } } } },
    "open camera" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "افتح الكاميرا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "buka kamera" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "kamerayı aç" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "کیمرہ کھولیں" } } } },
    "confirm mat scan" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تأكيد مسح السجادة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "konfirmasi pindai sajadah" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "seccade taramasını onayla" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "جائے نماز اسکین کی تصدیق کریں" } } } },
    "retake photo" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أعد التقاط الصورة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "ambil ulang foto" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "fotoğrafı yeniden çek" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "تصویر دوبارہ لیں" } } } },
    "Mat Scan" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مسح السجادة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pindai Sajadah" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seccade Taraması" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "جائے نماز اسکین" } } } },
    "Camera unavailable" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الكاميرا غير متاحة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kamera tidak tersedia" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kamera kullanılamıyor" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "کیمرہ دستیاب نہیں" } } } },
    "This simulator does not provide a camera feed. Test mat scan on a device." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "هذا المحاكي لا يوفر كاميرا. جرّب مسح السجادة على جهاز حقيقي." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Simulator ini tidak menyediakan kamera. Uji pindai sajadah di perangkat." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu simülatörde kamera yok. Seccade taramasını bir cihazda test et." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اس سمیولیٹر میں کیمرہ نہیں ہے۔ جائے نماز اسکین کسی ڈیوائس پر آزمائیں۔" } } } },
    "scan your prayer mat to dismiss" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "امسح سجادة صلاتك للإيقاف" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "pindai sajadah untuk mematikan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "kapatmak için seccadeni tarat" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "بند کرنے کے لیے جائے نماز اسکین کریں" } } } },
    "Point your camera at your janamaz and confirm the scan." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "وجّه الكاميرا نحو سجادتك وأكّد المسح." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Arahkan kamera ke sajadah dan konfirmasi pemindaian." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kameranı seccadene doğrult ve taramayı onayla." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "کیمرہ جائے نماز کی طرف کریں اور اسکین کی تصدیق کریں۔" } } } },
    "scan mat" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "امسح السجادة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "pindai sajadah" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "seccadeyi tarat" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "جائے نماز اسکین کریں" } } } },
    "dismiss manually" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إيقاف يدوي" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "matikan manual" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "elle kapat" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "دستی طور پر بند کریں" } } } },
    "Dismiss without praying?" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إيقاف دون أن تصلي؟" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Matikan tanpa salat?" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namaz kılmadan kapatılsın mı?" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نماز پڑھے بغیر بند کریں؟" } } } },
    "Cancel" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إلغاء" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Batal" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Vazgeç" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "منسوخ کریں" } } } },
    "Yes, I'll pray later" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "نعم، سأصلي لاحقًا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Ya, saya akan salat nanti" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Evet, sonra kılacağım" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ہاں، میں بعد میں پڑھوں گا/گی" } } } },
    "Use manual dismissal only if you need to come back later." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "استخدم الإيقاف اليدوي فقط إذا كنت ستعود لاحقًا." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Gunakan mematikan manual hanya jika Anda perlu kembali nanti." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Elle kapatmayı yalnızca daha sonra dönmen gerekiyorsa kullan." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "دستی طور پر بند کرنا صرف تب استعمال کریں جب آپ کو بعد میں واپس آنا ہو۔" } } } },
    "Prayer Settings" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إعدادات الصلاة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pengaturan Salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namaz Ayarları" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نماز سیٹنگز" } } } },
