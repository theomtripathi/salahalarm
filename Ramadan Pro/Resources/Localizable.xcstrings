    "I want all five prayers, daily" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أريد أداء الصلوات الخمس يوميًا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Saya ingin salat lima waktu setiap hari" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Her gün beş vakit namaz kılmak istiyorum" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "میں روزانہ پانچوں نمازیں ادا کرنا چاہتا/چاہتی ہوں" } } } },
    "I want to improve my consistency" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أريد أن أكون أكثر مواظبة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Saya ingin lebih konsisten" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Düzenimi geliştirmek istiyorum" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "میں اپنی پابندی بہتر کرنا چاہتا/چاہتی ہوں" } } } },
    "I'm trying to pray more often" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أحاول أداء الصلاة بانتظام أكبر" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Saya berusaha lebih sering salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Daha sık namaz kılmaya çalışıyorum" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "میں زیادہ نماز پڑھنے کی کوشش کر رہا/رہی ہوں" } } } },
    "I want to build the habit" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أريد بناء هذه العادة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Saya ingin membangun kebiasaan ini" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu alışkanlığı edinmek istiyorum" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "میں یہ عادت بنانا چاہتا/چاہتی ہوں" } } } },
    "I'm still exploring for now" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ما زلت أستكشف حاليًا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Untuk saat ini saya masih menjajaki" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Şimdilik keşfetmeye devam ediyorum" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "میں ابھی دریافت کر رہا/رہی ہوں" } } } },
    "A Simpler Path Back to Every Salah." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "طريق أبسط للعودة إلى كل صلاة." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Jalan yang lebih sederhana untuk kembali menjaga setiap salat." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Her namaza yeniden yönelmenin daha sade bir yolu." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ہر نماز کی طرف لوٹنے کا آسان راستہ۔" } } } },
    "Your plan is ready. Save it to keep your routine with you." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "خطتك جاهزة. احفظها لترافقك في روتينك." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Rencana Anda siap. Simpan agar rutinitas ini selalu menemani Anda." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Planınız hazır. Rutininizi yanınızda taşımak için kaydedin." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کا پلان تیار ہے۔ اسے محفوظ کریں تاکہ معمول آپ کے ساتھ رہے۔" } } } },
    "Choose your language" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختر لغتك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pilih bahasa Anda" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dilinizi seçin" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنی زبان منتخب کریں" } } } },
    "Start your journey in the language you feel at home with." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ابدأ رحلتك باللغة التي تشعر بالراحة عند استخدامها." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mulai perjalanan Anda dengan bahasa yang terasa nyaman." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kendinizi en rahat hissettiğiniz dilde yolculuğunuza başlayın." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنا سفر اس زبان میں شروع کریں جس میں آپ خود کو پُرسکون محسوس کریں۔" } } } },
    "Language" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اللغة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Bahasa" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dil" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "زبان" } } } },
    "You can change this anytime in Profile." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يمكنك تغيير ذلك في أي وقت من الملف الشخصي." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Anda dapat mengubahnya kapan saja di Profil." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bunu Profil bölümünden istediğiniz zaman değiştirebilirsiniz." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ اسے پروفائل میں کسی بھی وقت تبدیل کر سکتے ہیں۔" } } } },
    "Done" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Selesai" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bitti" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "مکمل" } } } },
    "Back" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "رجوع" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kembali" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Geri" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "واپس" } } } },
    "Set a starting routine" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حدّد روتينًا للبدء" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Atur rutinitas awal" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Başlangıç rutininizi belirleyin" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ابتدائی معمول طے کریں" } } } },
    "You can adjust these preferences after setup." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يمكنك تعديل هذه التفضيلات بعد الإعداد." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Preferensi ini dapat diubah setelah penyiapan." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu tercihleri kurulumdan sonra değiştirebilirsiniz." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ سیٹ اپ کے بعد ان ترجیحات کو تبدیل کر سکتے ہیں۔" } } } },
    "App language" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لغة التطبيق" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Bahasa aplikasi" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Uygulama dili" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ایپ کی زبان" } } } },
    "English" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الإنجليزية" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Inggris" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İngilizce" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "انگریزی" } } } },
    "Arabic" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "العربية" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Arab" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Arapça" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "عربی" } } } },
    "Turkish" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التركية" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Turki" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Türkçe" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ترکی" } } } },
    "Indonesian" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الإندونيسية" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Indonesia" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Endonezce" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "انڈونیشیائی" } } } },
    "Urdu" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الأردية" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Urdu" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Urduca" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اردو" } } } },
    "7 days free" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "7 أيام مجانًا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "7 hari gratis" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "7 gün ücretsiz" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "7 دن مفت" } } } },
    "7 days free trial" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فترة تجريبية مجانية لمدة 7 أيام" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Uji coba gratis 7 hari" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "7 günlük ücretsiz deneme" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "7 دن کا مفت ٹرائل" } } } },
    "Billed %@ once a year after your trial." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "سيتم تحصيل %@ مرة واحدة سنويًا بعد انتهاء الفترة التجريبية." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "%@ ditagihkan sekali setahun setelah masa uji coba." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Deneme sürenizden sonra yılda bir kez %@ tahsil edilir." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ٹرائل کے بعد سال میں ایک بار %@ وصول کیے جائیں گے۔" } } } },
    "Billed annually" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يُحصّل سنويًا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Ditagih setiap tahun" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yıllık olarak ücretlendirilir" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سالانہ وصولی" } } } },
    "Cancel in App Store subscription settings at least 24 hours before the trial ends to avoid being charged." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لتجنب تحصيل الرسوم، ألغِ الاشتراك من إعدادات اشتراكات App Store قبل انتهاء الفترة التجريبية بـ24 ساعة على الأقل." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Agar tidak dikenai biaya, batalkan melalui pengaturan langganan App Store setidaknya 24 jam sebelum masa uji coba berakhir." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ücret ödememek için deneme süresi bitmeden en az 24 saat önce App Store abonelik ayarlarından iptal edin." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "چارج سے بچنے کے لیے ٹرائل ختم ہونے سے کم از کم 24 گھنٹے پہلے App Store کی سبسکرپشن سیٹنگز میں منسوخ کریں۔" } } } },
    "Continue with Apple" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "المتابعة باستخدام Apple" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Lanjutkan dengan Apple" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Apple ile devam et" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "Apple کے ساتھ جاری رکھیں" } } } },
    "Continue with Email" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "المتابعة باستخدام البريد الإلكتروني" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Lanjutkan dengan Email" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "E-posta ile devam et" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ای میل کے ساتھ جاری رکھیں" } } } },
    "Continue with Google" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "المتابعة باستخدام Google" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Lanjutkan dengan Google" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Google ile devam et" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "Google کے ساتھ جاری رکھیں" } } } },
    "Discounted Yearly" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اشتراك سنوي مخفّض" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Paket Tahunan Diskon" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İndirimli Yıllık Plan" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "رعایتی سالانہ سبسکرپشن" } } } },
    "Enjoy 7 days of SalahAlarm as you build a routine around salah. Start with one prayer, one day at a time." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "استمتع باستخدام SalahAlarm لمدة 7 أيام بينما تبني روتينًا للصلاة. ابدأ بصلاة واحدة، يومًا بعد يوم." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Nikmati SalahAlarm selama 7 hari sambil membangun rutinitas salat. Mulailah dengan satu waktu salat, satu hari demi satu hari." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namaz rutininizi oluştururken SalahAlarm'ı 7 gün boyunca deneyin. Her seferinde günde bir namazla başlayın." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نماز کا معمول بناتے ہوئے SalahAlarm کے 7 دن استعمال کریں۔ ایک وقت کی نماز سے آغاز کریں، روزانہ ایک قدم۔" } } } },
    "No thanks" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا شكرًا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tidak, terima kasih" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hayır, teşekkürler" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نہیں، شکریہ" } } } },
    "Not a monthly plan. Renews automatically each year unless cancelled. Cancel in App Store subscription settings at least 24 hours before the trial ends to avoid being charged." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "هذه ليست خطة شهرية. يتجدد الاشتراك تلقائيًا كل عام ما لم يتم إلغاؤه. لتجنب تحصيل الرسوم، ألغِ الاشتراك من إعدادات اشتراكات App Store قبل انتهاء الفترة التجريبية بـ24 ساعة على الأقل." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Ini bukan paket bulanan. Langganan diperpanjang otomatis setiap tahun kecuali dibatalkan. Agar tidak dikenai biaya, batalkan melalui pengaturan langganan App Store setidaknya 24 jam sebelum masa uji coba berakhir." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu aylık bir plan değildir. İptal edilmediği sürece her yıl otomatik yenilenir. Ücret ödememek için deneme süresi bitmeden en az 24 saat önce App Store abonelik ayarlarından iptal edin." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "یہ ماہانہ پلان نہیں ہے۔ منسوخ نہ کرنے پر ہر سال خودکار تجدید ہوگی۔ چارج سے بچنے کے لیے ٹرائل ختم ہونے سے کم از کم 24 گھنٹے پہلے App Store کی سبسکرپشن سیٹنگز میں منسوخ کریں۔" } } } },
    "Start my 7-day free trial" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ابدأ الفترة التجريبية المجانية لمدة 7 أيام" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mulai uji coba gratis 7 hari" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "7 günlük ücretsiz denememi başlat" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "میرا 7 روزہ مفت ٹرائل شروع کریں" } } } },
    "Then a yearly subscription" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ثم اشتراك سنوي" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Lalu berlangganan tahunan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ardından yıllık abonelik" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اس کے بعد سالانہ سبسکرپشن" } } } },
    "You already show up for salah daily and want stronger consistency." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تحافظ على الصلاة يوميًا، وترغب في مزيد من الثبات." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kamu sudah salat setiap hari dan ingin lebih konsisten." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Her gün namaz kılıyorsunuz ve bunu daha düzenli hâle getirmek istiyorsunuz." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ روزانہ نماز ادا کرتے ہیں اور مزید پابندی چاہتے ہیں۔" } } } },
    "%@ / month equivalent" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ما يعادل %@ شهريًا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "setara %@ per bulan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "aylık %@ karşılığı" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ماہانہ %@ کے مساوی" } } } },
    "12 months of full access for one yearly payment." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "12 شهرًا من الوصول الكامل مقابل دفعة سنوية واحدة." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Akses penuh selama 12 bulan dengan satu pembayaran tahunan." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tek bir yıllık ödemeyle 12 ay boyunca tüm özelliklere erişin." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ایک سالانہ ادائیگی میں 12 ماہ کی مکمل رسائی۔" } } } },
    "Checking your free trial…" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ التحقق من الفترة التجريبية المجانية…" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Memeriksa uji coba gratis…" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ücretsiz denemeniz kontrol ediliyor…" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "مفت ٹرائل کی جانچ ہو رہی ہے…" } } } },
    "Decline free trial" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "رفض الفترة التجريبية المجانية" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tolak uji coba gratis" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ücretsiz denemeyi reddet" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "مفت ٹرائل مسترد کریں" } } } },
