    "Committed" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ملتزم" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Berkomitmen" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kararlı" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "پُرعزم" } } } },
