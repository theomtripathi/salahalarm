    "Your reviews help us reach more Muslims and improve the app." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تقييماتك تساعدنا على الوصول إلى مزيد من المسلمين وتحسين التطبيق." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Ulasan Anda membantu kami menjangkau lebih banyak Muslim dan menyempurnakan aplikasi." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Değerlendirmelerin daha çok Müslümana ulaşmamıza ve uygulamayı geliştirmemize yardımcı olur." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کے ریویوز ہمیں زیادہ مسلمانوں تک پہنچنے اور ایپ بہتر بنانے میں مدد دیتے ہیں۔" } } } },
