    "Take the first step, on us." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الخطوة الأولى على حسابنا." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Langkah pertama, gratis dari kami." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İlk adım bizden." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "پہلا قدم ہماری طرف سے۔" } } } },
