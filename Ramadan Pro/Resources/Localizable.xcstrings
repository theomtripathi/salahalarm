    "choose your plan" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختر خطتك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pilih paket Anda" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Planınızı seçin" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنا پلان منتخب کریں" } } } },
    "get full access to every tool in SalahAlarm" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "احصل على وصول كامل إلى جميع أدوات SalahAlarm" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Dapatkan akses penuh ke semua fitur SalahAlarm" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "SalahAlarm'daki tüm araçlara tam erişim sağlayın" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "SalahAlarm کے تمام ٹولز تک مکمل رسائی حاصل کریں" } } } },
    "help us improve the experience" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ساعدنا على تحسين تجربتك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Bantu kami meningkatkan pengalaman Anda" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Deneyimi geliştirmemize yardımcı olun" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "تجربے کو بہتر بنانے میں ہماری مدد کریں" } } } },
    "one payment. a full year of SalahLock, alarms, duas, and every future feature. cancel anytime." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "دفعة واحدة مقابل عام كامل من SalahLock والمنبهات والأدعية وجميع الميزات المستقبلية. يمكنك الإلغاء في أي وقت." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Satu pembayaran untuk setahun penuh SalahLock, alarm, doa, dan semua fitur mendatang. Batalkan kapan saja." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tek ödemeyle bir yıl boyunca SalahLock, alarmlar, dualar ve gelecekteki tüm özellikler. İstediğiniz zaman iptal edin." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ایک ادائیگی میں پورا سال SalahLock، الارمز، دعائیں اور آئندہ تمام فیچرز۔ کسی بھی وقت منسوخ کریں۔" } } } },
    "per month" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "شهريًا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "per bulan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "aylık" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ماہانہ" } } } },
    "per year" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "سنويًا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "per tahun" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "yıllık" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سالانہ" } } } },
    "so we can keep making the app better for you" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لنواصل تحسين التطبيق من أجلك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Agar kami terus menyempurnakan aplikasi untuk Anda" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Uygulamayı sizin için geliştirmeye devam edebilmemiz için" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "تاکہ ہم آپ کے لیے ایپ کو بہتر بناتے رہیں" } } } },
    "support future development" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ادعم التطوير المستقبلي" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Dukung pengembangan mendatang" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Gelecekteki geliştirmeleri destekleyin" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آئندہ ترقی میں معاونت کریں" } } } },
