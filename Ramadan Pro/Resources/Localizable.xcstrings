    "Trial: %@ – %@" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الفترة التجريبية: %@ – %@" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Uji coba: %@ – %@" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Deneme: %@ – %@" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ٹرائل: %@ – %@" } } } },
    "Your free trial ends %@." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تنتهي فترتك التجريبية المجانية في %@." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Uji coba gratis Anda berakhir %@." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ücretsiz denemen %@ tarihinde bitiyor." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کا مفت ٹرائل %@ کو ختم ہوگا۔" } } } },
    "Your free trial is active." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فترتك التجريبية المجانية نشطة." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Uji coba gratis Anda aktif." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ücretsiz denemen aktif." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کا مفت ٹرائل جاری ہے۔" } } } },
    "Assalamu Alaikum, %@ 🌙" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "السلام عليكم، %@ 🌙" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Assalamu'alaikum, %@ 🌙" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Esselâmu aleyküm, %@ 🌙" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "السلام علیکم، %@ 🌙" } } } },
    "Your city" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مدينتك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kota Anda" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Şehrin" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کا شہر" } } } },
    "apps locked — pray %@ to unlock" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التطبيقات مقفلة، صلِّ %@ لفتحها" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "aplikasi terkunci — salat %@ untuk membuka" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "uygulamalar kilitli, açmak için %@ namazını kıl" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ایپس لاک ہیں، کھولنے کے لیے %@ پڑھیں" } } } },
    "SalahLock armed · apps unlocked" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "SalahLock مفعّل · التطبيقات مفتوحة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "SalahLock aktif · aplikasi terbuka" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "SalahLock hazır · uygulamalar açık" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "SalahLock فعال · ایپس کھلی ہیں" } } } },
    "Find the direction of the Kaaba" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اعرف اتجاه الكعبة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Temukan arah Ka'bah" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kâbe'nin yönünü bul" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "کعبہ کی سمت معلوم کریں" } } } },
    "Streak maintained! ✓" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حافظت على سلسلتك! ✓" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Rangkaian terjaga! ✓" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seri korundu! ✓" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اسٹریک برقرار ہے! ✓" } } } },
    "%d prayers today to keep your streak" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "%d صلوات اليوم للحفاظ على سلسلتك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "%d salat hari ini untuk menjaga rangkaian" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Serini korumak için bugün %d namaz" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اسٹریک برقرار رکھنے کے لیے آج %d نمازیں" } } } },
    "Alarm access is locked" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الوصول إلى المنبهات مقفل" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Akses alarm terkunci" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Alarm erişimi kilitli" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "الارم تک رسائی لاک ہے" } } } },
    "Your subscription is inactive. Renew to keep prayer alarms running." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اشتراكك غير نشط. جدّده لتبقى منبهات الصلاة تعمل." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Langganan Anda tidak aktif. Perpanjang agar alarm salat tetap berjalan." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Aboneliğin aktif değil. Namaz alarmlarının çalışması için yenile." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کی سبسکرپشن غیر فعال ہے۔ نماز کے الارم جاری رکھنے کے لیے تجدید کریں۔" } } } },
    "No more alarms scheduled today." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا توجد منبهات أخرى اليوم." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tidak ada alarm lagi hari ini." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bugün başka alarm yok." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آج مزید کوئی الارم شیڈول نہیں۔" } } } },
    "Tomorrow's prayer alarms will refresh automatically." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ستتجدد منبهات صلاة الغد تلقائيًا." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Alarm salat besok akan diperbarui otomatis." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yarının namaz alarmları otomatik olarak yenilenecek." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "کل کے نماز الارم خود بخود ریفریش ہو جائیں گے۔" } } } },
    "%d / 5 prayed" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "%d / 5 صلوات" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "%d / 5 sudah salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%d / 5 kılındı" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "%d / 5 ادا" } } } },
    "Missed" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فائتة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Terlewat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kaçırıldı" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "قضا" } } } },
    "Confirm 🤲" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تأكيد 🤲" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Konfirmasi 🤲" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Onayla 🤲" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "تصدیق کریں 🤲" } } } },
    "Add SalahAlarm to your Home Screen" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أضف SalahAlarm إلى شاشتك الرئيسية" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tambahkan SalahAlarm ke Layar Utama" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "SalahAlarm'ı Ana Ekranına ekle" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "SalahAlarm کو اپنی ہوم اسکرین پر شامل کریں" } } } },
    "See your streak and next prayer time without opening the app." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "شاهد سلسلتك ووقت الصلاة التالية دون فتح التطبيق." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Lihat rangkaian dan waktu salat berikutnya tanpa membuka aplikasi." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Uygulamayı açmadan serini ve sonraki namaz vaktini gör." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ایپ کھولے بغیر اپنی اسٹریک اور اگلی نماز کا وقت دیکھیں۔" } } } },
    "Add Widget →" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أضف الأداة ←" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tambah Widget →" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Widget Ekle →" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ویجیٹ شامل کریں ←" } } } },
