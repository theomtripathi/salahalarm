    "in %dm" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "بعد %d د" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "dalam %d m" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%d dk sonra" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "%d منٹ میں" } } } },
    "Friend" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "صديقي" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Sahabat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dostum" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "دوست" } } } },
    "Moderate mode - auto-marks missed after 10 minutes" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الوضع المتوسط - يُسجَّل كفائت تلقائيًا بعد 10 دقائق" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mode sedang - otomatis ditandai terlewat setelah 10 menit" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Orta mod - 10 dakika sonra otomatik olarak kaçırıldı işaretlenir" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "درمیانہ موڈ - 10 منٹ بعد خود بخود قضا درج ہو جاتی ہے" } } } },
    "Relaxed mode - one snooze before scan is required" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الوضع المرن - غفوة واحدة قبل أن يلزم المسح" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mode santai - satu kali tunda sebelum wajib pindai" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Rahat mod - tarama gerekmeden önce bir erteleme" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نرم موڈ - اسکین سے پہلے ایک بار اسنوز" } } } },
    "Strict mode - scan your prayer mat to dismiss" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الوضع الصارم - امسح سجادتك للإيقاف" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mode ketat - pindai sajadah untuk mematikan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sıkı mod - kapatmak için seccadeni tarat" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سخت موڈ - بند کرنے کے لیے جائے نماز اسکین کریں" } } } },
    "locked" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مقفل" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "terkunci" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "kilitli" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "لاک" } } } },
    "armed" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مفعّل" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "aktif" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "hazır" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "فعال" } } } },
    "off" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "متوقف" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "mati" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "kapalı" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "بند" } } } },
    "Pray %@ (%@) to unlock your apps" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "صلِّ %@ (%@) لفتح تطبيقاتك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Salat %@ (%@) untuk membuka aplikasi Anda" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Uygulamalarını açmak için %@ (%@) namazını kıl" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنی ایپس کھولنے کے لیے %@ (%@) پڑھیں" } } } },
    "I've prayed %@ 🤲" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "صلّيت %@ 🤲" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Saya sudah salat %@ 🤲" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ namazını kıldım 🤲" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "میں نے %@ پڑھ لی 🤲" } } } },
    "Finish setup below to activate the prayer lock" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أكمل الإعداد أدناه لتفعيل قفل الصلاة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Selesaikan pengaturan di bawah untuk mengaktifkan kunci salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namaz kilidini etkinleştirmek için aşağıdaki kurulumu tamamla" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نماز لاک فعال کرنے کے لیے نیچے سیٹ اپ مکمل کریں" } } } },
    "Waiting for your prayer times…" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "بانتظار مواقيت صلاتك…" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Menunggu waktu salat Anda…" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namaz vakitlerin bekleniyor…" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کے اوقاتِ نماز کا انتظار ہے…" } } } },
    "Apps lock at %@, %@" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تُقفل التطبيقات عند %@، %@" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Aplikasi terkunci saat %@, %@" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Uygulamalar %@, %@ saatinde kilitlenir" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ایپس %@، %@ پر لاک ہوں گی" } } } },
    "No more locks today — see you at the next prayer" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا مزيد من الأقفال اليوم، نراك في الصلاة القادمة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tidak ada kunci lagi hari ini — sampai jumpa di salat berikutnya" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bugün başka kilit yok, sonraki namazda görüşürüz" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آج مزید کوئی لاک نہیں، اگلی نماز پر ملیں گے" } } } },
    "Connect Screen Time" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اربط مدة استخدام الجهاز" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hubungkan Durasi Layar" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ekran Süresi'ni Bağla" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اسکرین ٹائم سے جوڑیں" } } } },
    "SalahAlarm uses Apple's Screen Time to temporarily block your chosen apps until you've prayed. Nothing is tracked and nothing leaves your phone." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يستخدم SalahAlarm ميزة مدة استخدام الجهاز من Apple لحظر التطبيقات التي تختارها مؤقتًا حتى تصلي. لا يتم تتبع أي شيء ولا يغادر أي شيء هاتفك." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "SalahAlarm menggunakan Durasi Layar Apple untuk memblokir sementara aplikasi pilihan Anda sampai Anda salat. Tidak ada yang dilacak dan tidak ada yang keluar dari ponsel Anda." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "SalahAlarm, seçtiğin uygulamaları namaz kılana kadar geçici olarak engellemek için Apple'ın Ekran Süresi'ni kullanır. Hiçbir şey takip edilmez ve hiçbir şey telefonundan çıkmaz." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "SalahAlarm آپ کی منتخب ایپس کو نماز پڑھنے تک عارضی طور پر بلاک کرنے کے لیے Apple کا اسکرین ٹائم استعمال کرتا ہے۔ کچھ بھی ٹریک نہیں ہوتا اور کچھ بھی آپ کے فون سے باہر نہیں جاتا۔" } } } },
    "Connecting…" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ الربط…" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Menghubungkan…" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bağlanıyor…" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "جوڑا جا رہا ہے…" } } } },
    "Choose the apps that distract you from salah" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختر التطبيقات التي تشغلك عن الصلاة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pilih aplikasi yang mengalihkan Anda dari salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seni namazdan alıkoyan uygulamaları seç" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "وہ ایپس چنیں جو آپ کو نماز سے غافل کرتی ہیں" } } } },
    "Change apps" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تغيير التطبيقات" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Ubah aplikasi" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Uygulamaları değiştir" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ایپس تبدیل کریں" } } } },
    "Lock for these prayers" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "القفل لهذه الصلوات" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kunci untuk salat ini" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu namazlar için kilitle" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ان نمازوں کے لیے لاک کریں" } } } },
    "Your apps lock when prayer time arrives and unlock when you confirm you've prayed." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تُقفل تطبيقاتك عند دخول وقت الصلاة وتُفتح عندما تؤكد أنك صليت." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Aplikasi terkunci saat waktu salat tiba dan terbuka setelah Anda konfirmasi sudah salat." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Uygulamaların namaz vakti gelince kilitlenir, namazını kıldığını onayladığında açılır." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نماز کا وقت آنے پر ایپس لاک ہو جاتی ہیں اور نماز کی تصدیق پر کھل جاتی ہیں۔" } } } },
    "Select at least one prayer to activate the lock" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختر صلاة واحدة على الأقل لتفعيل القفل" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pilih minimal satu salat untuk mengaktifkan kunci" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kilidi etkinleştirmek için en az bir namaz seç" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "لاک فعال کرنے کے لیے کم از کم ایک نماز منتخب کریں" } } } },
    "Turn off to pause app locking" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أوقفه لإيقاف قفل التطبيقات مؤقتًا" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Matikan untuk menjeda penguncian aplikasi" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Uygulama kilidini duraklatmak için kapat" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ایپ لاکنگ روکنے کے لیے بند کریں" } } } },
    "Your chosen apps get locked" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تُقفل التطبيقات التي اخترتها" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Aplikasi pilihan Anda terkunci" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seçtiğin uygulamalar kilitlenir" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کی منتخب ایپس لاک ہو جاتی ہیں" } } } },
    "You pray" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تصلي" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Anda salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namazını kılarsın" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ نماز پڑھتے ہیں" } } } },
    "Confirm that you've prayed to unlock" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أكّد أنك صليت لفتحها" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Konfirmasi sudah salat untuk membuka" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Açmak için namaz kıldığını onayla" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "کھولنے کے لیے نماز کی تصدیق کریں" } } } },
    "Keep SalahAlarm on your phone — deleting the app removes the lock." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أبقِ SalahAlarm على هاتفك، فحذف التطبيق يزيل القفل." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Simpan SalahAlarm di ponsel Anda — menghapus aplikasi akan menghapus kunci." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "SalahAlarm'ı telefonunda tut; uygulamayı silmek kilidi kaldırır." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "SalahAlarm کو اپنے فون پر رکھیں، ایپ حذف کرنے سے لاک ختم ہو جاتا ہے۔" } } } },
    "Qibla" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "القبلة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kiblat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kıble" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "قبلہ" } } } },
    "Find the right direction for your salah." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اعرف الاتجاه الصحيح لصلاتك." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Temukan arah yang tepat untuk salat Anda." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namazın için doğru yönü bul." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنی نماز کے لیے صحیح سمت معلوم کریں۔" } } } },
    "Aligned with Qibla" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "متّجه نحو القبلة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Sudah menghadap kiblat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kıbleye dönük" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "قبلہ رخ ہے" } } } },
    "Move your phone slowly to calibrate." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حرّك هاتفك ببطء للمعايرة." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Gerakkan ponsel perlahan untuk kalibrasi." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kalibrasyon için telefonunu yavaşça hareket ettir." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "کیلیبریٹ کرنے کے لیے فون آہستہ سے ہلائیں۔" } } } },
    "How to use it" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "طريقة الاستخدام" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Cara menggunakannya" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Nasıl kullanılır" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "استعمال کا طریقہ" } } } },
    "Hold your phone flat, rotate slowly, and follow the gold needle until it aligns." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أمسك هاتفك بشكل مستوٍ، واستدر ببطء، واتبع الإبرة الذهبية حتى تستقيم." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pegang ponsel mendatar, putar perlahan, dan ikuti jarum emas hingga sejajar." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Telefonunu düz tut, yavaşça dön ve altın ibre hizalanana kadar takip et." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "فون کو سیدھا رکھیں، آہستہ گھومیں اور سنہری سوئی کے سیدھا ہونے تک اس کی پیروی کریں۔" } } } },
    "%d km to the Kaaba" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "%d كم إلى الكعبة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "%d km ke Ka'bah" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kâbe'ye %d km" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "کعبہ تک %d کلومیٹر" } } } },
    "City" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "المدينة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kota" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Şehir" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "شہر" } } } },
    "Locating…" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ تحديد الموقع…" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mencari lokasi…" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Konum bulunuyor…" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "مقام معلوم کیا جا رہا ہے…" } } } },
    "Sensor accuracy" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "دقة المستشعر" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Akurasi sensor" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sensör doğruluğu" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سینسر کی درستگی" } } } },
    "Alignment threshold" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حد المحاذاة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Batas kesejajaran" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hizalama eşiği" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سمت کی حد" } } } },
    "High" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "عالية" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tinggi" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yüksek" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "زیادہ" } } } },
    "Medium" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "متوسطة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Sedang" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Orta" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "درمیانی" } } } },
    "Low" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "منخفضة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Rendah" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Düşük" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "کم" } } } },
    "Turn right %d°" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "استدر يمينًا %d°" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Putar ke kanan %d°" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sağa %d° dön" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "دائیں %d° مڑیں" } } } },
    "Turn left %d°" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "استدر يسارًا %d°" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Putar ke kiri %d°" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sola %d° dön" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "بائیں %d° مڑیں" } } } },
    "Unknown" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "غير معروف" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tidak diketahui" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bilinmiyor" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نامعلوم" } } } },
    "Home" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الرئيسية" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Beranda" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ana Sayfa" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ہوم" } } } },
    "Prayers" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الصلوات" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namazlar" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نمازیں" } } } },
    "Lock" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "القفل" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kunci" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kilit" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "لاک" } } } },
    "Profile" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الملف الشخصي" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Profil" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Profil" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "پروفائل" } } } },
    "%d of %d" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "%d من %d" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "%d dari %d" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%d / %d" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "%d میں سے %d" } } } },
    "%@ • %d ayahs" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "%@ • %d آيات" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "%@ • %d ayat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ • %d ayet" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "%@ • %d آیات" } } } },
    "This action cannot be undone. All your data will be permanently deleted." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا يمكن التراجع عن هذا الإجراء. ستُحذف جميع بياناتك نهائيًا." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tindakan ini tidak dapat dibatalkan. Semua data Anda akan dihapus permanen." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu işlem geri alınamaz. Tüm verilerin kalıcı olarak silinecek." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "یہ عمل واپس نہیں ہو سکتا۔ آپ کا تمام ڈیٹا ہمیشہ کے لیے حذف ہو جائے گا۔" } } } },
    "Enter your password" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أدخل كلمة المرور" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Masukkan kata sandi Anda" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Şifreni gir" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنا پاس ورڈ درج کریں" } } } },
    "Error" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "خطأ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kesalahan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hata" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "خرابی" } } } },
    "Welcome Back" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مرحبًا بعودتك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Selamat Datang Kembali" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tekrar Hoş Geldin" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "خوش آمدید" } } } },
    "sign in to keep your prayer plan, streak, and alarms in sync." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "سجّل الدخول لمزامنة خطة صلاتك وسلسلتك ومنبهاتك." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "masuk agar rencana salat, rangkaian, dan alarm Anda tetap sinkron." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "namaz planını, serini ve alarmlarını senkronize tutmak için giriş yap." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنا نماز پلان، اسٹریک اور الارم ہم آہنگ رکھنے کے لیے سائن اِن کریں۔" } } } },
    "Forgot?" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "نسيتها؟" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Lupa?" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Unuttun mu?" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "بھول گئے؟" } } } },
    "enter your password" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أدخل كلمة المرور" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "masukkan kata sandi" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "şifreni gir" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنا پاس ورڈ درج کریں" } } } },
    "Hide" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إخفاء" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Sembunyikan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Gizle" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "چھپائیں" } } } },
    "Show" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إظهار" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tampilkan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Göster" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "دکھائیں" } } } },
    "don't have an account?" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ليس لديك حساب؟" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "belum punya akun?" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "hesabın yok mu?" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اکاؤنٹ نہیں ہے؟" } } } },
    "create one now" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أنشئ حسابًا الآن" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "buat sekarang" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "hemen oluştur" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ابھی بنائیں" } } } },
    "Signing in..." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ تسجيل الدخول..." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Sedang masuk..." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Giriş yapılıyor..." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سائن اِن ہو رہا ہے..." } } } },
    "Sending reset email..." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ إرسال بريد إعادة التعيين..." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mengirim email reset..." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sıfırlama e-postası gönderiliyor..." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ری سیٹ ای میل بھیجی جا رہی ہے..." } } } },
    "Success" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم بنجاح" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Berhasil" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Başarılı" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "کامیاب" } } } },
    "Reset Password" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إعادة تعيين كلمة المرور" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Atur Ulang Kata Sandi" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Şifreyi Sıfırla" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "پاس ورڈ ری سیٹ کریں" } } } },
    "Enter your email and we'll send you a link to reset your password" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أدخل بريدك الإلكتروني وسنرسل لك رابطًا لإعادة تعيين كلمة المرور" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Masukkan email Anda dan kami akan mengirim tautan untuk mengatur ulang kata sandi" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "E-postanı gir, şifreni sıfırlaman için bir bağlantı gönderelim" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنی ای میل درج کریں، ہم پاس ورڈ ری سیٹ کرنے کا لنک بھیجیں گے" } } } },
    "Enter your email" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أدخل بريدك الإلكتروني" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Masukkan email Anda" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "E-postanı gir" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنی ای میل درج کریں" } } } },
    "Send Reset Link" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أرسل رابط إعادة التعيين" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kirim Tautan Reset" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sıfırlama Bağlantısı Gönder" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ری سیٹ لنک بھیجیں" } } } },
    "Continue" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "متابعة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Lanjut" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Devam et" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "جاری رکھیں" } } } },
    "A full, loud adhan-style call tuned for daily prayers." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "نداء كامل وعالٍ بأسلوب الأذان مهيأ للصلوات اليومية." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Panggilan bergaya azan yang penuh dan keras untuk salat harian." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Günlük namazlar için ayarlanmış, güçlü ve tam bir ezan sesi." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "روزانہ نمازوں کے لیے مکمل اور بلند اذان طرز کی آواز۔" } } } },
    "A strong, clear mosque-style adhan with a steady tone." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أذان قوي وواضح بأسلوب المساجد بنبرة ثابتة." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Azan bergaya masjid yang kuat dan jernih dengan nada stabil." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sabit tonda, güçlü ve net bir cami ezanı." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "مستحکم لہجے میں مضبوط اور صاف مسجد طرز کی اذان۔" } } } },
    "A more piercing wake-up style option for early mornings." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "خيار أكثر حدة للاستيقاظ في الصباح الباكر." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pilihan bangun yang lebih menusuk untuk dini hari." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sabah erken saatler için daha keskin bir uyandırma seçeneği." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "صبح سویرے جاگنے کے لیے زیادہ تیز آپشن۔" } } } },
    "A high-intensity alarm fallback when you need something sharp." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "منبه احتياطي عالي الشدة عندما تحتاج إلى صوت حاد." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Alarm cadangan berintensitas tinggi saat Anda butuh suara tajam." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Keskin bir sese ihtiyacın olduğunda yüksek şiddetli yedek alarm." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "جب کچھ تیز آواز چاہیے تو زیادہ شدت والا متبادل الارم۔" } } } },
    "A funny wake-up alarm sound." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "صوت منبه طريف للاستيقاظ." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Suara alarm bangun yang lucu." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Komik bir uyandırma alarmı sesi." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "جاگنے کے لیے مزاحیہ الارم کی آواز۔" } } } },
    "Select a custom audio file from your device." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختر ملفًا صوتيًا مخصصًا من جهازك." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pilih file audio kustom dari perangkat Anda." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Cihazından özel bir ses dosyası seç." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنی ڈیوائس سے کوئی آڈیو فائل منتخب کریں۔" } } } },
    "Makkah" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مكة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Makkah" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Mekke" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "مکہ" } } } },
    "Madinah" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "المدينة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Madinah" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Medine" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "مدینہ" } } } },
    "Fajr" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الفجر" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Subuh" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sabah" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "فجر" } } } },
    "Takbir" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التكبير" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Takbir" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tekbir" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "تکبیر" } } } },
    "Custom" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مخصص" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kustom" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Özel" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنی مرضی" } } } },
    "Strict" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "صارم" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Ketat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sıkı" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سخت" } } } },
    "Moderate" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "متوسط" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Sedang" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Orta" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "درمیانہ" } } } },
    "Relaxed" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مرن" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Santai" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Rahat" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نرم" } } } },
    "Strict - rings until I scan my mat" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "صارم - يرنّ حتى أمسح سجادتي" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Ketat - berbunyi sampai saya memindai sajadah" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sıkı - seccademi taratana kadar çalar" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سخت - جائے نماز اسکین کرنے تک بجتا رہے" } } } },
    "Moderate - 10 minutes, then marks missed" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "متوسط - 10 دقائق ثم يُسجَّل كفائت" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Sedang - 10 menit, lalu ditandai terlewat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Orta - 10 dakika, sonra kaçırıldı işaretlenir" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "درمیانہ - 10 منٹ، پھر قضا درج" } } } },
    "Relaxed - one snooze, then must scan" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مرن - غفوة واحدة ثم يلزم المسح" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Santai - satu kali tunda, lalu wajib pindai" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Rahat - bir erteleme, sonra tarama gerekir" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نرم - ایک اسنوز، پھر اسکین لازمی" } } } },
    "Rings until you dismiss it from the prayer flow." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يرنّ حتى توقفه من خلال خطوات الصلاة." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Berbunyi sampai Anda mematikannya dari alur salat." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Namaz akışından kapatana kadar çalar." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "تب تک بجتا ہے جب تک آپ نماز کے مرحلے سے اسے بند نہ کریں۔" } } } },
    "Lets the alarm expire after 10 minutes if you miss it." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يسمح بانتهاء المنبه بعد 10 دقائق إذا فاتك." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Alarm berakhir setelah 10 menit jika Anda melewatkannya." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kaçırırsan alarm 10 dakika sonra sona erer." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "اگر آپ چوک جائیں تو الارم 10 منٹ بعد ختم ہو جاتا ہے۔" } } } },
    "Allows one snooze before asking you to dismiss it." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يسمح بغفوة واحدة قبل أن يطلب منك إيقافه." } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mengizinkan satu kali tunda sebelum meminta Anda mematikannya." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kapatmanı istemeden önce bir ertelemeye izin verir." } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "بند کرنے کا کہنے سے پہلے ایک اسنوز کی اجازت دیتا ہے۔" } } } },
    "Yearly" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "سنوي" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tahunan" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yıllık" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "سالانہ" } } } },
    "Imsak" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الإمساك" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Imsak" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İmsak" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "امساک" } } } },
