    "your support helps us build new features" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يساعدنا دعمك على إنشاء ميزات جديدة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Dukungan Anda membantu kami membuat fitur baru" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Desteğiniz yeni özellikler geliştirmemize yardımcı olur" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کی معاونت سے ہمیں نئے فیچرز بنانے میں مدد ملتی ہے" } } } },
