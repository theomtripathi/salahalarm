    "Set up a prayer alarm" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اضبط منبه صلاة" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Atur alarm salat" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bir namaz alarmı kur" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "نماز کا الارم سیٹ کریں" } } } },
    "Open alarm settings" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "افتح إعدادات المنبه" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Buka pengaturan alarm" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Alarm ayarlarını aç" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "الارم سیٹنگز کھولیں" } } } },
    "Log a prayer during your trial" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "سجّل صلاة خلال فترتك التجريبية" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Catat salat selama masa uji coba" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Deneme süresinde bir namaz kaydet" } }, "ur" : { "stringUnit" : { "state" : "translated", "value" : "ٹرائل کے دوران ایک نماز درج کریں" } } } },
