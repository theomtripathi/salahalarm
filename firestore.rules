rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own data
      allow read: if isOwner(userId);
      
      // Users can write their own data (for impact updates)
      allow write: if isOwner(userId);
      
      // Allow authenticated users to update their impact field
      allow update: if isAuthenticated() && 
                       request.auth.uid == userId &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['impact']);
    }
    
    // Donations collection
    match /donations/{donationId} {
      // Users can create their own donations
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      
      // Users can read their own donations
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // Users can update their own donations (if needed)
      allow update: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid;
      
      // Users can delete their own donations (if needed)
      allow delete: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid;
    }
    
    // Leaderboard collection
    match /leaderboard/{userId} {
      // Anyone can read the leaderboard (public)
      allow read: if true;
      
      // Users can create/update their own leaderboard entry
      allow write: if isAuthenticated() && 
                      (request.resource.data.userId == request.auth.uid || 
                       resource == null || 
                       resource.data.userId == request.auth.uid);
    }
    
    // Ramadan Ready challenge: invite codes. Create-only by the owner, so a
    // taken code fails and the app retries. Anyone signed in can read a code
    // (to show who invited them) and bump its joinedCount by exactly 1.
    match /referrals/{code} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       request.resource.data.ownerUid == request.auth.uid &&
                       request.resource.data.joinedCount == 0;
      allow update: if isAuthenticated() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedCount']) &&
                       request.resource.data.joinedCount == resource.data.joinedCount + 1;
    }

    // Ramadan Ready challenge: public joiner count (also read by salahalarm.com).
    match /challengeStats/{docId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.joinedCount == 1;
      allow update: if isAuthenticated() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedCount']) &&
                       request.resource.data.joinedCount == resource.data.joinedCount + 1;
    }

    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
