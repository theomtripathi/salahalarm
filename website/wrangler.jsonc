// Deploys the static build in dist/ as the "salahalarm" Worker. Routes (not custom
// domains) so the conversion-tracking Worker's salahalarm.com/go/* route wins for /go.
{
  "name": "salahalarm",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.js",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Affiliate links (salahalarm.com/<username>) and onboarding beacons go to the affiliate Worker.
  "services": [
    { "binding": "AFFILIATES", "service": "salahalarm-affiliates" }
  ],
  "routes": [
    { "pattern": "salahalarm.com/*", "zone_name": "salahalarm.com" },
    { "pattern": "www.salahalarm.com/*", "zone_name": "salahalarm.com" }
  ]
}
